# Copia este archivo a .env y rellena los valores de TU workspace.
#   cp .env.example .env

#================= Suscripción de Azure =================
# az account show --query id -o tsv
AZURE_SUBSCRIPTION_ID=<tu-subscription-id>
AZURE_RESOURCE_GROUP=<tu-resource-group>
AZURE_WORKSPACE_NAME=<tu-workspace>
AZURE_TENANT_ID=<tu-tenant-id>
AZURE_REGION=brazilsouth

#================= Batch endpoint =======================
BATCH_ENDPOINT_NAME=<nombre-del-batch-endpoint>
BATCH_DEPLOYMENT_NAME=<nombre-de-la-batch-deployment>
AZURE_ML_REST_ENDPOINT=https://<batch-endpoint>.<region>.inference.ml.azure.com/jobs

#================= Online endpoint (real-time) ==========
ONLINE_ENDPOINT_URL=https://<online-endpoint>.<region>.inference.ml.azure.com/score
ONLINE_DEPLOYMENT_NAME=blue
# az ml online-endpoint get-credentials -n <online-endpoint> \
#   -g <resource-group> -w <workspace> --query primaryKey -o tsv
ONLINE_ENDPOINT_KEY=<primary-key-del-endpoint>
